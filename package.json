{
  "name": "kynetik-build-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "supabase start && supabase db reset && tsx scripts/local-env.ts && npm run bootstrap:owner && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project domain --passWithNoTests",
    "test:db": "vitest run --project db",
    "seed:generate": "tsx supabase/seed/generate.ts",
    "db:reset": "supabase db reset",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "deploy:sql": "tsx scripts/deploy-sql.ts",
    "test:e2e": "playwright test",
    "check:prod": "tsx scripts/security-check.ts",
    "displays:create": "tsx scripts/create-displays.ts",
    "demo:add": "tsx scripts/demo-data.ts",
    "demo:remove": "tsx scripts/demo-data.ts --remove"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "canvas-confetti": "^1.9.4",
    "fractional-indexing": "^4.0.0",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "pg": "^8.23.1",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
