# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.
# Locally, `npm run dev:all` writes .env.local for you from `supabase status`.

# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Public URL of this app, used in email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Who becomes the first Owner (npm run bootstrap:owner).
OWNER_EMAIL=you@example.com

# Tests only: a Postgres superuser for the RLS tests (npm run test:db).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Local deploy scripts only (never on Vercel).
# npm run check:prod — the hosted project's Postgres connection string (Dashboard → Connect). Never printed.
DATABASE_URL=postgres://postgres.YOUR-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# …or, instead of DATABASE_URL, run the check through the Management API:
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# Optional: also check one live TV feed (no cost fields, one department only).
SITE_URL=
DISPLAY_TOKEN=
